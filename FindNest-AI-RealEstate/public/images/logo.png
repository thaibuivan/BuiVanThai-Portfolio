    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        /* ============================================
           DESIGN TOKENS
        ============================================ */
        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A26;
            --primary-glow: rgba(255,107,53,0.35);
            --secondary: #0A0A0F;
            --secondary-soft: #1A1A2E;
            --accent: #FFD700;
            --blue: #6C63FF;
            --green: #22C55E;
            --surface: #F8F9FA;
            --text-muted: #6C757D;
            --border: rgba(0,0,0,0.08);
            --border-light: rgba(255,255,255,0.1);
            --shadow: 0 4px 24px rgba(0,0,0,0.07);
            --shadow-hover: 0 20px 60px rgba(255,107,53,0.2);
            --radius: 20px;
            --radius-sm: 12px;
            --transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            --transition-smooth: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --light: #F5F5F7;
        }

        /* ============================================
           RESET & BASE
        ============================================ */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Be Vietnam Pro', system-ui, sans-serif;
            background: #FAFAFA;
            color: var(--secondary);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            /* Sticky footer: footer luôn nằm đáy, không chừa khoảng trắng dưới (mọi thiết bị) */
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        body > main { flex: 1 0 auto; }
        body > .footer-hs { flex-shrink: 0; }

        /* ============================================
           PAGE LOADER
        ============================================ */
        #page-loader {
            position: fixed;
            inset: 0;
            background: #0A0A0F;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }
        #page-loader.loaded {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .loader-logo {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 2rem;
            font-weight: 900;
            color: #fff;
            letter-spacing: -1px;
            animation: loaderPulse 1s ease infinite;
        }
        .loader-logo span { color: var(--primary); }
        .loader-bar-wrap {
            width: 200px;
            height: 3px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            overflow: hidden;
        }
        .loader-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 2px;
            animation: loaderFill 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        @keyframes loaderFill {
            0% { width: 0%; }
            60% { width: 80%; }
            100% { width: 100%; }
        }
        @keyframes loaderPulse {
            0%,100% { opacity: 1; }
            50% { opacity: 0.6; }
        }



        /* ============================================
           NAVBAR
        ============================================ */
        .navbar-hs {
            background: rgba(255,255,255,0.8);
            backdrop-filter: saturate(180%) blur(24px);
            -webkit-backdrop-filter: saturate(180%) blur(24px);
            border-bottom: 1px solid rgba(0,0,0,0.06);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            transition: all 0.4s ease;
        }
        .navbar-hs.scrolled {
            padding: 8px 0;
            box-shadow: 0 4px 30px rgba(0,0,0,0.08);
            background: rgba(255,255,255,0.95);
        }
        .navbar-brand-hs {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 1.6rem;
            font-weight: 900;
            color: var(--primary) !important;
            text-decoration: none;
            letter-spacing: -0.5px;
            transition: var(--transition);
        }
        .navbar-brand-hs:hover { transform: scale(1.03); }
        .navbar-brand-hs span { color: var(--secondary); }
        .nav-link-hs {
            color: var(--secondary) !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 8px 14px !important;
            border-radius: 8px;
            transition: var(--transition-smooth);
            text-decoration: none;
            position: relative;
        }
        .nav-link-hs::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 14px; right: 14px;
            height: 2px;
            background: var(--primary);
            border-radius: 1px;
            transform: scaleX(0);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .nav-link-hs:hover::after { transform: scaleX(1); }
        .nav-link-hs:hover { color: var(--primary) !important; }
        .btn-nav-post {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff !important;
            font-weight: 700;
            padding: 9px 22px !important;
            border-radius: 10px;
            transition: var(--transition);
            box-shadow: 0 4px 15px rgba(255,107,53,0.3);
            position: relative;
            overflow: hidden;
        }
        .btn-nav-post::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }
        .btn-nav-post:hover::before { left: 100%; }
        .btn-nav-post:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255,107,53,0.45);
        }

        /* ============================================
           BUTTONS
        ============================================ */
        .btn-primary-hs {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 700;
            padding: 13px 30px;
            transition: var(--transition);
            box-shadow: 0 4px 20px rgba(255,107,53,0.3);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }
        .btn-primary-hs::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .btn-primary-hs:hover { color: #fff; transform: translateY(-3px) scale(1.02); box-shadow: 0 20px 50px rgba(255,107,53,0.45); }
        .btn-primary-hs:hover::after { opacity: 1; }
        .btn-outline-hs {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            border-radius: var(--radius-sm);
            font-weight: 700;
            padding: 11px 28px;
            transition: var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }
        .btn-outline-hs::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--primary);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }
        .btn-outline-hs span, .btn-outline-hs i { position: relative; z-index: 1; }
        .btn-outline-hs:hover::before { transform: scaleX(1); }
        .btn-outline-hs:hover { color: #fff; transform: translateY(-2px); }

        /* ============================================
           ROOM CARD — Premium
        ============================================ */
        .room-card {
            background: #fff;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition-smooth);
            border: 1px solid var(--border);
            height: 100%;
            position: relative;
        }
        .room-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: var(--radius);
            border: 2px solid transparent;
            background: linear-gradient(135deg, var(--primary), var(--blue)) border-box;
            -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: destination-out;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .room-card:hover::before { opacity: 1; }
        .room-card:hover {
            transform: translateY(-10px) scale(1.01);
            box-shadow: var(--shadow-hover);
        }
        .room-card-img {
            height: 210px;
            object-fit: cover;
            width: 100%;
            background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .room-card:hover .room-card-img { transform: scale(1.08); }
        .room-card-img-wrap { overflow: hidden; position: relative; }
        .room-card-img-wrap::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 50%);
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .room-card:hover .room-card-img-wrap::after { opacity: 1; }
        .room-badge {
            position: absolute;
            top: 12px; left: 12px;
            background: var(--primary);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            z-index: 2;
            backdrop-filter: blur(8px);
        }
        .room-badge-featured {
            background: rgba(255,215,0,0.95);
            color: #7a5a00;
        }
        .room-card-body { padding: 18px; }
        .room-price {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--primary);
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .room-title {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--secondary);
            margin: 6px 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
        }
        .room-meta {
            font-size: 0.82rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .room-meta i { color: var(--primary); }

        /* ============================================
           SECTION STYLES
        ============================================ */
        .section-title {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--secondary);
            letter-spacing: -0.5px;
            line-height: 1.2;
        }
        .section-subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            max-width: 520px;
            margin: 0 auto;
            line-height: 1.7;
        }
        .section-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,107,53,0.1);
            color: var(--primary);
            font-weight: 700;
            font-size: 0.78rem;
            padding: 5px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: 1px solid rgba(255,107,53,0.2);
        }

        /* ============================================
           SCROLL-REVEAL Utility
        ============================================ */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                        transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .reveal.revealed { opacity: 1; transform: translateY(0); }
        .reveal-left {
            opacity: 0;
            transform: translateX(-50px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .reveal-left.revealed { opacity: 1; transform: translateX(0); }
        .reveal-right {
            opacity: 0;
            transform: translateX(50px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .reveal-right.revealed { opacity: 1; transform: translateX(0); }
        .reveal-scale {
            opacity: 0;
            transform: scale(0.85);
            transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .reveal-scale.revealed { opacity: 1; transform: scale(1); }

        /* Stagger delays */
        .stagger-1 { transition-delay: 0.05s !important; }
        .stagger-2 { transition-delay: 0.12s !important; }
        .stagger-3 { transition-delay: 0.19s !important; }
        .stagger-4 { transition-delay: 0.26s !important; }
        .stagger-5 { transition-delay: 0.33s !important; }
        .stagger-6 { transition-delay: 0.40s !important; }
        .stagger-7 { transition-delay: 0.47s !important; }
        .stagger-8 { transition-delay: 0.54s !important; }

        /* ============================================
           COUNTER ANIMATION
        ============================================ */
        .count-up { display: inline-block; }

        /* ============================================
           ALERTS
        ============================================ */
        .alert-hs {
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.92rem;
            font-weight: 500;
            animation: slideDown 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes slideDown {
            from { transform: translateY(-20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* ============================================
           TOAST NOTIFICATIONS
        ============================================ */
        .toast-container-hs {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast-hs {
            background: #fff;
            border-radius: 14px;
            padding: 14px 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.12);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 280px;
            max-width: 380px;
            font-size: 0.9rem;
            font-weight: 500;
            border-left: 4px solid var(--primary);
            animation: toastIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .toast-hs.success { border-left-color: var(--green); }
        .toast-hs.error { border-left-color: #ef4444; }
        .toast-hs i { font-size: 1.2rem; }
        .toast-hs.success i { color: var(--green); }
        .toast-hs.error i { color: #ef4444; }
        @keyframes toastIn {
            from { transform: translateX(120%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes toastOut {
            to { transform: translateX(120%); opacity: 0; }
        }
        .toast-hs.removing { animation: toastOut 0.4s ease forwards; }

        /* ============================================
           FOOTER
        ============================================ */
        .footer-hs {
            background: linear-gradient(180deg, #0A0A0F, #1A1A2E);
            color: rgba(255,255,255,0.7);
            padding: 70px 0 30px;
            position: relative;
            overflow: hidden;
        }
        .footer-hs::before {
            content: '';
            position: absolute;
            top: -200px; left: 50%;
            transform: translateX(-50%);
            width: 800px; height: 400px;
            background: radial-gradient(circle, rgba(255,107,53,0.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .footer-brand {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: 1.6rem;
            font-weight: 900;
            color: #fff;
        }
        .footer-brand span { color: var(--primary); }
        .footer-link {
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.25s ease;
            display: block;
            margin-bottom: 10px;
        }
        .footer-link:hover {
            color: var(--primary);
            transform: translateX(4px);
        }
        .footer-divider { border-color: rgba(255,255,255,0.08); margin: 40px 0 24px; }

        /* ============================================
           SCROLLBAR CUSTOM
        ============================================ */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(var(--primary), var(--blue)); border-radius: 4px; }

        /* ============================================
           MOBILE
        ============================================ */
        @media (max-width: 768px) {
            .section-title { font-size: 1.7rem; }
        }

        /* ============================================
           MOBILE BOTTOM NAVIGATION BAR
        ============================================ */
        .mobile-bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255,255,255,0.97);
            backdrop-filter: saturate(180%) blur(24px);
            -webkit-backdrop-filter: saturate(180%) blur(24px);
            border-top: 1px solid rgba(0,0,0,0.06);
            z-index: 9998;
            padding: 0;
            padding-bottom: env(safe-area-inset-bottom, 0);
            box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
        }
        @media (max-width: 991.98px) {
            .mobile-bottom-nav { display: flex; }
            body {
                padding-bottom: 72px;
            }
            .footer-hs {
                padding-bottom: 100px;
            }
        }
        .mobile-bottom-nav-inner {
            display: flex;
            align-items: flex-end;
            justify-content: space-around;
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            position: relative;
        }
        .mobile-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: #6C757D;
            font-size: 0.65rem;
            font-weight: 600;
            padding: 8px 0 6px;
            flex: 1;
            transition: color 0.25s ease;
            position: relative;
            -webkit-tap-highlight-color: transparent;
        }
        .mobile-nav-item i {
            font-size: 1.15rem;
            margin-bottom: 3px;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .mobile-nav-item.active {
            color: var(--primary);
        }
        .mobile-nav-item.active i {
            transform: scale(1.15);
        }
        .mobile-nav-item.active::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 24px;
            height: 3px;
            background: var(--primary);
            border-radius: 0 0 4px 4px;
        }
        .mobile-nav-item:hover, .mobile-nav-item:focus {
            color: var(--primary);
        }
        .mobile-nav-item .nav-badge-new {
            position: absolute;
            top: 4px;
            right: 50%;
            transform: translateX(calc(50% + 12px));
            background: var(--primary);
            color: #fff;
            font-size: 0.5rem;
            font-weight: 800;
            padding: 1px 4px;
            border-radius: 4px;
            letter-spacing: 0.3px;
            line-height: 1.2;
        }

        /* Center FAB (Đăng tin) */
        .mobile-nav-fab {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            text-decoration: none;
            flex: 1;
            position: relative;
            padding-bottom: 6px;
            -webkit-tap-highlight-color: transparent;
        }
        .mobile-nav-fab-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            box-shadow: 0 4px 18px rgba(255,107,53,0.4);
            position: relative;
            top: -14px;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            border: 3px solid #fff;
        }
        .mobile-nav-fab-btn:active {
            transform: scale(0.92);
        }
        .mobile-nav-fab-label {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--primary);
            margin-top: -10px;
        }

        /* ============================================
           MOBILE SLIDE-OUT MENU (from bottom nav More)
        ============================================ */
        .mobile-menu-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 10000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
            -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);
        }
        .mobile-menu-overlay.open {
            opacity: 1;
            visibility: visible;
        }
        .mobile-menu-panel {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #fff;
            z-index: 10001;
            border-radius: 24px 24px 0 0;
            max-height: 85vh;
            overflow-y: auto;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            padding: 0 0 env(safe-area-inset-bottom, 16px);
            box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
        }
        .mobile-menu-panel.open {
            transform: translateY(0);
        }
        .mobile-menu-handle {
            display: flex;
            justify-content: center;
            padding: 12px 0 8px;
        }
        .mobile-menu-handle span {
            width: 40px;
            height: 4px;
            background: #ddd;
            border-radius: 4px;
        }
        .mobile-menu-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 4px 20px 16px;
            border-bottom: 1px solid rgba(0,0,0,0.06);
        }
        .mobile-menu-header h5 {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--secondary);
            margin: 0;
        }
        .mobile-menu-close {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: none;
            background: #f5f5f5;
            color: var(--secondary);
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .mobile-menu-close:hover {
            background: #eee;
        }
        .mobile-menu-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            background: #fafafa;
        }
        .mobile-menu-user img {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary);
        }
        .mobile-menu-user-info .name {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--secondary);
        }
        .mobile-menu-user-info .email {
            font-size: 0.78rem;
            color: var(--text-muted);
        }
        .mobile-menu-links {
            padding: 8px 12px;
        }
        .mobile-menu-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 12px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--secondary);
            font-size: 0.92rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .mobile-menu-link:hover, .mobile-menu-link:active {
            background: rgba(255,107,53,0.06);
            color: var(--primary);
        }
        .mobile-menu-link i {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        .mobile-menu-link .link-icon-orange { background: rgba(255,107,53,0.1); color: var(--primary); }
        .mobile-menu-link .link-icon-blue { background: rgba(108,99,255,0.1); color: var(--blue); }
        .mobile-menu-link .link-icon-green { background: rgba(34,197,94,0.1); color: var(--green); }
        .mobile-menu-link .link-icon-red { background: rgba(239,68,68,0.1); color: #ef4444; }
        .mobile-menu-link .link-icon-yellow { background: rgba(255,215,0,0.15); color: #d4a800; }
        .mobile-menu-link .link-icon-purple { background: rgba(139,92,246,0.1); color: #8b5cf6; }
        .mobile-menu-divider {
            height: 1px;
            background: rgba(0,0,0,0.05);
            margin: 4px 12px;
        }
        .mobile-menu-link .new-tag {
            background: var(--primary);
            color: #fff;
            font-size: 0.55rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 6px;
            margin-left: auto;
            letter-spacing: 0.3px;
        }
        .mobile-menu-link.logout-link {
            color: #ef4444;
        }
        .mobile-menu-link.logout-link:hover {
            background: rgba(239,68,68,0.06);
        }

        /* ============================================
           PROGRESS BAR (top of page on load)
        ============================================ */
        #scroll-progress {
            position: fixed;
            top: 0; left: 0;
            height: 3px;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--accent), var(--blue));
            z-index: 99999;
            transition: width 0.1s linear;
        }

        /* ============================================
           GLOW EFFECT on hover
        ============================================ */
        .glow-on-hover {
            position: relative;
        }
        .glow-on-hover::after {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: inherit;
            background: linear-gradient(135deg, var(--primary), var(--blue));
            opacity: 0;
            z-index: -1;
            filter: blur(12px);
            transition: opacity 0.4s ease;
        }
        .glow-on-hover:hover::after { opacity: 0.5; }

        /* ============================================
           GRADIENT TEXT ANIMATION
        ============================================ */
        .gradient-text-animate {
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 50%, #ff9a9e 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 3s linear infinite;
        }
        @keyframes gradientShift {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }
    </style>

    </head>
<body>


