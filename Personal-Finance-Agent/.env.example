# Excel output
EXCEL_PATH=data/finance_dashboard_v4.xlsx

# Notification privacy: private | balanced | detailed
NOTIFICATION_MODE=balanced

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IMAP email source
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional filters. Examples: vietcombank, techcombank, noreply
IMAP_SENDER_FILTER=
IMAP_SUBJECT_FILTER=

# false keeps unread state intact. true may mark fetched messages as read.
IMAP_MARK_SEEN=false

# Gmail API OAuth
GMAIL_CREDENTIALS_PATH=config/google_credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_QUERY=newer_than:30d

# Google Drive upload for cloud mode
DRIVE_UPLOAD_ENABLED=false
DRIVE_FILE_ID_PATH=data/drive_file_id.txt
DRIVE_FILE_NAME=finance_dashboard.xlsx
DRIVE_FOLDER_ID=
